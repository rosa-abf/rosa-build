var DatePickerController = function($scope, datepickerPopupConfig) {

  var vm = this;

  vm.minDate = new Date(2010, 1, 1);
  vm.maxDate = moment().add(1, 'months').calendar();

  vm.today = function() {
    vm.dt = new Date();
  };

  vm.today();

  vm.clear = function() {
    vm.dt = null;
  };

  // Disable weekend selection
  vm.disabled = function(date, mode) {
    return mode === 'day' && (date.getDay() === 0 || date.getDay() === 6);
  };

  vm.toggleMin = function() {
    vm.minDate = vm.minDate ? null : new Date();
  };

  vm.toggleMin();

  vm.open_updated_at_start = function($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.updated_at_start_opened = true;
  };

  vm.open_updated_at_end = function($event) {
    $event.preventDefault();
    $event.stopPropagation();
    vm.updated_at_end_opened = true;
  };

  // ERB код будет заменен сервером
  vm.dateOptions = {
    formatYear: 'yy',
    startingDay: <%=  I18n.locale == :ru ? 1 : 0 %>,
    'show-weeks': false
  };

  vm.initDate = vm.today();
  vm.format = 'dd/MM/yyyy';

  // ERB код для русской локали
  <% if I18n.locale == :ru %>
    // TRANSLATION
    datepickerPopupConfig.currentText = 'Сегодня';
    datepickerPopupConfig.clearText = 'Очистить';
    datepickerPopupConfig.weeksText = 'Недели';
    datepickerPopupConfig.closeText = 'Закрыть';
  <% end %>

  //datepickerPopupConfig.appendToBody = 'true'
};

angular
  .module("RosaABF")
  .controller("DatePickerController", DatePickerController);

DatePickerController.$inject = [
  '$scope',
  'datepickerPopupConfig'
];

