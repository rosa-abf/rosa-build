doctype html
html
  head
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    meta content="text/html; charset=utf-8" http-equiv="Content-Type"
    == csrf_meta_tag
    title
      = get_page_title site: APP_CONFIG['project_name']
    == stylesheet_pack_tag 'application'

  body
    == render 'layouts/menu/new_top'
    == render 'layouts/noscript'
    == render "layouts/flashes"

    article.container-fluid.offset10
      .row
        .col-md-6.col-md-offset-3
          .panel.panel-primary
            .panel-heading
              = image_pack_tag 'logo.png', class: 'img-responsive center-block img-rounded'
          == yield
    == render 'layouts/menu/new_bottom'
    == javascript_pack_tag 'application', 'login'
    == yield :additional_scripts if content_for?(:additional_scripts)
